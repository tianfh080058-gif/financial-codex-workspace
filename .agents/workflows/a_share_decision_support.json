        "field": "horizon",
        "label_zh": "观察周期",
        "question_zh": "决策辅助看多长周期？",
        "default_zh": "20d"
      },
      {
        "field": "analysis_mode",
        "label_zh": "分析模式",
        "question_zh": "使用哪种分析模式？",
        "default_zh": "decision_support"
      }
