{
  "workflow_id": "watchlist_daily_review",
  "title": "Watchlist daily review",
  "user_entry": {
    "scenario_id": "watchlist_management",
    "executor": "watchlist_review",
    "label_zh": "观察池管理与每日摘要",
    "match_terms": [
      "查看观察池",
      "观察池配置",
      "股票池",
      "watchlist",
      "提醒",
      "加入观察池",
      "删除观察池",
      "生成观察池摘要"
    ],
    "example_utterances": [
      "查看我的默认观察池",
      "生成今天的观察池摘要",
      "检查价格提醒"
    ],
    "primary_action": "查看观察池、检查提醒或生成每日摘要",
    "required_inputs_ui": [
      {
        "field": "watchlist_file",
        "label_zh": "观察池文件",
        "question_zh": "使用哪个观察池文件？",
        "default_zh": ".research/watchlists/default.json"
      },
      {
        "field": "review_date",
        "label_zh": "复盘日期",
        "question_zh": "复盘哪一天？",
        "default_zh": "今天"
      },
      {
        "field": "analysis_mode",
        "label_zh": "分析模式",
        "question_zh": "使用研究模式还是决策辅助模式？",
        "default_zh": "research"
      }
    ],
    "default_display_profile": "app_card"
  },
  "intent_triggers": [
    "观察池复盘",
    "每日股票池检查",
    "watchlist daily review",
    "批量标的研究",
    "搜索股票",
    "添加价格提醒",
    "检查价格提醒",
    "生成观察池摘要"
  ],
  "required_skills": [
    "financial-services-skill-router",
    "china-market-overlay",
    "a-share-equity-research-workflow",
    "a-share-research-product-workflow",
    "financial-output-qa-gate"
  ],
  "execution_order": [
    "financial-services-skill-router",
    "china-market-overlay",
    "a-share-equity-research-workflow",
    "a-share-research-product-workflow",
    "financial-output-qa-gate"
  ],
  "required_inputs": [
    "watchlist_file",
    "review_date",
    "analysis_mode"
  ],
  "optional_inputs": [
    "market_context",
    "local_ohlcv_folder",
    "thesis_history",
    "review_horizon",
    "alert_rules",
    "news_preferences",
    "source_refresh_policy"
  ],
  "pipeline_stages": [
    {
      "stage_id": "search",
      "purpose": "Normalize user-provided A-share names or tickers before watchlist updates.",
      "cli_command": "python3 -m trading_core.cli search --query 300033 --format json",
      "output": "search_candidates"
    },
    {
      "stage_id": "watchlist",
      "purpose": "Create, update, or display the local watchlist with alert/news/source refresh metadata.",
      "cli_command": "python3 -m trading_core.cli watchlist --file .research/watchlists/default.json",
      "output": "watchlist_summary"
    },
    {
      "stage_id": "alerts",
      "purpose": "Add, list, or check local conditional price alerts without creating orders.",
      "cli_command": "python3 -m trading_core.cli alerts --check --file .research/alerts/alerts.jsonl",
      "output": "alert_check_result"
    },
    {
      "stage_id": "brief",
      "purpose": "Build the daily local market brief for the active watchlist.",
      "cli_command": "python3 -m trading_core.cli brief --watchlist .research/watchlists/default.json",
      "output": "market_brief"
    }
  ],
  "required_references": [
    ".agents/references/output-contract.md",
    ".agents/references/data-capability-registry.md",
    ".agents/references/display-profiles.md",
    ".agents/references/local-research-artifacts.md",
    ".agents/references/watchlist-management.md"
  ],
  "prompts": [
    "prompts/watchlist-management-zh.md",
    "prompts/a-share-watchlist-daily-review-zh.md",
    "prompts/openstock-style-market-workspace-zh.md",
    "prompts/app-conversation-display-zh.md"
  ],
  "cli_commands": [
    "python3 -m trading_core.cli search --query 300033 --format json",
    "python3 -m trading_core.cli watchlist --file .research/watchlists/default.json",
    "python3 -m trading_core.cli alerts --add 300033.SZ --condition above --level 100 --expires 90d",
    "python3 -m trading_core.cli alerts --check --file .research/alerts/alerts.jsonl",
    "python3 -m trading_core.cli brief --watchlist .research/watchlists/default.json"
  ],
  "outputs": [
    "search_candidates",
    "watchlist_summary",
    "alert_rules",
    "alert_check_result",
    "market_brief",
    "ranked_attention_list",
    "source_log",
    "qa_status",
    "artifact_refs"
  ],
  "qa_gates": [
    "financial-output-qa-gate"
  ],
  "display_profile": "app_card",
  "artifact_paths": [
    ".research/watchlists/*.json",
    ".research/alerts/alerts.jsonl",
    ".research/briefs/YYYY-MM-DD/*.json",
    ".research/briefs/YYYY-MM-DD/*.md",
    ".research/runs/*.jsonl"
  ]
}
