{
  "workflow_id": "daily_a_share_decision_pipeline",
  "title": "Daily A-share watchlist-to-decision pipeline",
  "user_entry": {
    "scenario_id": "daily_watchlist_pipeline",
    "executor": "watchlist_review",
    "label_zh": "每日观察池到条件决策",
    "match_terms": [
      "每日",
      "今天",
      "看盘",
      "观察池",
      "股票池",
      "摘要",
      "提醒",
      "Top10",
      "Top5"
    ],
    "example_utterances": [
      "帮我看今天观察池",
      "跑一下每日A股决策流程",
      "从观察池筛 Top10，再挑 Top5 做条件决策"
    ],
    "primary_action": "检查观察池、提醒、Top10/Top5 和条件化决策候选",
    "required_inputs_ui": [
      {
        "field": "watchlist_file",
        "label_zh": "观察池文件",
        "question_zh": "使用哪个观察池文件？",
        "default_zh": ".research/watchlists/default.json"
      },
      {
        "field": "review_date",
        "label_zh": "复盘日期",
        "question_zh": "复盘哪一天？",
        "default_zh": "今天"
      },
      {
        "field": "analysis_mode",
        "label_zh": "分析模式",
        "question_zh": "使用研究模式还是决策辅助模式？",
        "default_zh": "decision_support"
      }
    ],
    "default_display_profile": "app_card"
  },
  "intent_triggers": [
    "每日A股决策流程",
    "观察池到交易计划",
    "Top10 Top5 条件化决策",
    "组合使用 watchlist deep research decision support",
    "OpenStock style local market workspace",
    "每日观察池摘要与提醒检查"
  ],
  "required_skills": [
    "financial-services-skill-router",
    "china-market-overlay",
    "a-share-equity-research-workflow",
    "a-share-research-product-workflow",
    "trading-decision-engine",
    "financial-output-qa-gate"
  ],
  "execution_order": [
    "financial-services-skill-router",
    "china-market-overlay",
    "a-share-equity-research-workflow",
    "a-share-research-product-workflow",
    "trading-decision-engine",
    "financial-output-qa-gate"
  ],
  "subworkflows": [
    "watchlist_daily_review",
    "a_share_deep_research",
    "a_share_decision_support"
  ],
  "required_inputs": [
    "watchlist_file",
    "review_date",
    "analysis_mode"
  ],
  "optional_inputs": [
    "market_context",
    "local_ohlcv_folder",
    "thesis_history",
    "review_horizon",
    "screen_top_n",
    "deep_research_top_n",
    "decision_horizon",
    "evidence_gate_policy",
    "polymarket_query_terms",
    "polymarket_lookback_days",
    "polymarket_max_markets",
    "alert_rules",
    "news_preferences",
    "source_refresh_policy"
  ],
  "defaults": {
    "screen_top_n": 10,
    "deep_research_top_n": 5,
    "decision_horizon": "20d",
    "evidence_gate_policy": "standard",
    "analysis_mode": "decision_support"
  },
  "pipeline_stages": [
    {
      "stage_id": "search_and_normalize",
      "workflow": "watchlist_daily_review",
      "purpose": "Normalize new A-share names or tickers before entering the watchlist.",
      "input_scope": "user_query_or_watchlist_update",
      "output": "search_candidates"
    },
    {
      "stage_id": "alert_check",
      "workflow": "watchlist_daily_review",
      "purpose": "Check local price alerts and carry triggered conditions into the daily brief as evidence, not instructions.",
      "input_scope": "active_alert_rules",
      "output": "alert_check_result"
    },
    {
      "stage_id": "market_brief",
      "workflow": "watchlist_daily_review",
      "purpose": "Build the daily watchlist market brief with quote availability, source gaps, and triggered alerts.",
      "input_scope": "full_watchlist",
      "output": "market_brief"
    },
    {
      "stage_id": "screen_top10",
      "workflow": "watchlist_daily_review",
      "purpose": "Rank the watchlist and select the Top10 attention list.",
      "input_scope": "full_watchlist",
      "output": "top10_watchlist"
    },
    {
      "stage_id": "deep_research_top5",
      "workflow": "a_share_deep_research",
      "purpose": "Run deep research on the default Top5 candidates while preserving source gaps.",
      "input_scope": "top10_watchlist[0:5]",
      "output": "top5_deep_research"
    },
    {
      "stage_id": "evidence_gate",
      "workflow": "financial-output-qa-gate",
      "purpose": "Allow only evidence-sufficient names into conditional decision support.",
      "input_scope": "top5_deep_research",
      "output": "decision_eligibility"
    },
    {
      "stage_id": "conditional_decision",
      "workflow": "a_share_decision_support",
      "purpose": "Build conditional trade plans only for eligible candidates.",
      "input_scope": "decision_eligibility.eligible",
      "output": "decision_cards"
    }
  ],
  "evidence_gate": {
    "required_status_to_enter_decision_support": "sufficient",
    "minimum_required_dimensions": [
      "market_data",
      "technical_daily_weekly",
      "polymarket_macro_or_source_gap",
      "one_non_technical_evidence",
      "risk_check",
      "qa_not_fail"
    ],
    "allowed_statuses": [
      "sufficient",
      "insufficient",
      "blocked"
    ],
    "blocked_routes": {
      "insufficient": "wait_or_data_gap",
      "blocked": "avoid_or_wait"
    }
  },
  "required_references": [
    ".agents/references/output-contract.md",
    ".agents/references/data-capability-registry.md",
    ".agents/references/display-profiles.md",
    ".agents/references/local-research-artifacts.md",
    ".agents/references/watchlist-management.md"
  ],
  "prompts": [
    "prompts/watchlist-management-zh.md",
    "prompts/openstock-style-market-workspace-zh.md",
    "prompts/daily-a-share-decision-pipeline-zh.md",
    "prompts/app-conversation-display-zh.md"
  ],
  "cli_commands": [
    "python3 -m trading_core.cli search --query 300033 --format json",
    "python3 -m trading_core.cli watchlist --file .research/watchlists/default.json",
    "python3 -m trading_core.cli alerts --check --file .research/alerts/alerts.jsonl",
    "python3 -m trading_core.cli brief --watchlist .research/watchlists/default.json --store",
    "python3 -m trading_core.cli decision --ticker 300033.SZ --market a_share --horizon 20d --mode conditional_strong",
    "python3 tools/check_research_integrity.py --input path/to/record.json --profile a_share_decision"
  ],
  "outputs": [
    "search_candidates",
    "alert_rules",
    "alert_check_result",
    "market_brief",
    "top10_watchlist",
    "top5_deep_research",
    "evidence_sufficiency",
    "decision_candidates",
    "wait_or_data_gap",
    "decision_cards",
    "prediction_market_context",
    "source_log",
    "qa_status",
    "artifact_refs"
  ],
  "qa_gates": [
    "financial-output-qa-gate"
  ],
  "display_profile": "app_card",
  "artifact_paths": [
    ".research/watchlists/*.json",
    ".research/alerts/alerts.jsonl",
    ".research/briefs/YYYY-MM-DD/*.json",
    ".research/briefs/YYYY-MM-DD/*.md",
    ".research/runs/*.jsonl",
    ".research/reports/YYYY-MM-DD/*.md",
    ".research/reviews/*.json"
  ]
}
